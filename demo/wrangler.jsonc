{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "auth-dance-demo",
	"compatibility_date": "2026-11-01",
	// A static site with no Worker script: `npm run build` writes it to `dist/client`.
	"assets": {
		"directory": "./dist/client",
		// Every page path gets the SPA shell, `index.html`.
		"not_found_handling": "single-page-application"
	},
	"routes": [{ "pattern": "demo.auth.dance", "custom_domain": true }]
}
