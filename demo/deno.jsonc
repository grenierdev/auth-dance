{
	"tasks": {
		"dev": "deno -A npm:vite",
		"dev:vite": "deno -A npm:vite",
		"build": "deno -A npm:vite build",
		"preview": "deno -A npm:vite preview",
		// Two checkers, because neither one covers the other. `deno check` reads the sources the way the runtime does,
		// through the import map above. `tsc -b` reads them the way the build does, through tsconfig.json, and it alone
		// applies the strictness in tsconfig.app.json — noUnusedLocals, erasableSyntaxOnly — and covers vite.config.ts.
		// --force so a stale tsbuildinfo cannot turn the task into a no-op.
		"check": "deno check && deno -A npm:typescript@~6.0.2/tsc -b --force",
		"deploy": "deno run --allow-all npm:wrangler deploy --config ./wrangler.jsonc"
	},
	// Generated trees: vite writes dist/ and .tanstack, wrangler writes .wrangler. Without this, `deno check` and
	// `deno lint` walk the emitted bundles.
	"exclude": [
		"dist",
		".tanstack",
		".wrangler",
		".output",
		".nitro"
	],
	"imports": {
		"@/": "./src/",
		"auth-dance": "../src/mod.ts",
		"auth-dance/components/email": "../src/components/email.ts",
		"auth-dance/components/otp": "../src/components/otp.ts",
		"auth-dance/components/password": "../src/components/password.ts",
		"auth-dance/components/totp": "../src/components/totp.ts",
		"auth-dance/components/webauthn": "../src/components/webauthn.ts",
		"auth-dance/providers/memory": "../src/providers/memory.ts",
		"@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.3",
		"@std/encoding": "jsr:@std/encoding@1.0.6"
	},
	"compilerOptions": {
		"lib": ["deno.ns", "dom", "dom.iterable", "esnext"],
		"jsx": "react-jsx",
		"jsxImportSource": "react"
	}
}
