{
	"workspace": [
		"./src",
		"./demo"
	],
	"nodeModulesDir": "auto",
	"imports": {
		"@hono/otel": "npm:@hono/otel@^1.1.2",
		"@hono/standard-validator": "npm:@hono/standard-validator@^0.2.3",
		"@scalar/hono-api-reference": "npm:@scalar/hono-api-reference@^0.11.8",
		"@std/assert": "jsr:@std/assert@1.0.11",
		"@std/encoding": "jsr:@std/encoding@1.0.6",
		"@std/testing": "jsr:@std/testing@^1.0.19",
		"@valibot/to-json-schema": "npm:@valibot/to-json-schema@^1.7.1",
		"hono": "npm:hono@^4.12.28",
		"hono-openapi": "npm:hono-openapi@^1.3.1",
		"jose": "npm:jose@^6.2.3",
		"openapi-merge": "npm:openapi-merge@^1.3.3",
		"openapi-types": "npm:openapi-types@^12.1.3",
		"shadcn": "npm:shadcn@^4.16.1",
		"valibot": "npm:valibot@^1.4.2"
	},
	"fmt": {
		"lineWidth": 140,
		"useTabs": true
	}
}
